<?xml version="1.0" encoding="UTF-8"?>
<!--
  ServEcosys Root Project - 依赖清单 (manifest.xml)

  说明：本文件列出构建一个可启动 ServEcosys 系统所需的所有源码/工具
  依赖及其获取方式，保证构建可复现、可追踪。
  使用 tools/repo 或 scripts/fetch_deps.sh 消费本清单。
-->
<manifest>
  <!-- ============ 上游源码 ============ -->

  <!-- 主内核：Linux 长期支持版 -->
  <project path="kernel/linux-src"
           name="linux"
           remote="kernel.org"
           revision="v6.6.y"
           upstream="v6.6.y" />

  <!-- 最小用户空间工具集 -->
  <project path="external/busybox"
           name="mirrors/busybox"
           remote="github"
           revision="1_36_1" />

  <!-- 引导链：UEFI 固件（可选，用于 QEMU/OVMF 测试） -->
  <project path="external/ovmf"
           name="tianocore/edk2"
           remote="github"
           revision="edk2-stable202311"
           optional="true" />

  <!-- ============ 远程定义 ============ -->
  <remote name="kernel.org"
          fetch="https://git.kernel.org/pub/scm/linux/kernel/git/stable/"
          review="" />

  <remote name="github"
          fetch="https://github.com/"
          review="" />

  <default remote="kernel.org" revision="master" />
</manifest>
