#
# ServEcosys Kernel Core - 内核中央 Kconfig
#
# 内核中央只包含内核最基础的功能，每个基础功能是一个原子。
# 通过 source 进内核源码树的 Kconfig 树（例如 init/Kconfig 或
# arch/Kconfig 的 source "kernel/core/Kconfig"）。
#
# 用法（补丁由 scripts/apply_kernel_patch.sh 注入）：
#   source "kernel/core/Kconfig"
#

config SERVECOSYS_CORE
	bool "ServEcosys Kernel Core - 内核中央"
	help
	  ServEcosys 内核中央：只包含内核最基础的功能（进程调度、
	  内存管理、网络协议栈），以原子形式提供，由 main.c 统一编排。

if SERVECOSYS_CORE

config SERVECOSYS_CORE_SCHED
	bool "原子: 进程调度"
	depends on SCHED_CFS
	default y
	help
	  进程调度原子（CFS + RT），纳入内核中央初始化序列。

config SERVECOSYS_CORE_MM
	bool "原子: 内存管理"
	default y
	help
	  内存管理原子（分页/THP/KSM），纳入内核中央初始化序列。

config SERVECOSYS_CORE_NET
	bool "原子: 网络协议栈"
	depends on INET
	default y
	help
	  网络协议栈原子（IPv4/IPv6 双栈），纳入内核中央初始化序列。

endif # SERVECOSYS_CORE
