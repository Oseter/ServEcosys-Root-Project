#!/bin/sh
#
# ServEcosys Initramfs Init Script v0.2.0
#
# 职责：
# 1. 挂载伪文件系统
# 2. 加载必要内核模块（btrfs, hardware probe）
# 3. 硬件指纹采集与验证
# 4. 搜索并挂载 Btrfs 根文件系统
# 5. 快照配置解析与快照引导
# 6. 切换到真实根文件系统（/sbin/init -> system/sysinit，完成 SED->UID 启动）
#

set -e

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export ROOT_MOUNT=/mnt/root
export SNAPSHOT_CONF=/boot/servecosys/snapshot.conf
export FINGERPRINT_SYSFS=/sys/kernel/servecosys/fingerprint

echo "============================================="
echo " ServEcosys initramfs v0.2.0"
echo "============================================="
echo ""

# ============================================
# [1/7] Pseudo filesystem mounting
# ============================================
echo "[1/7] Mounting pseudo filesystems..."
mkdir -p /proc /sys /dev /dev/pts /run
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run

# Populate /dev with additional nodes
mknod -m 660 /dev/console c 5 1 2>/dev/null || true

# ============================================
# [2/7] Essential kernel modules
# ============================================
echo "[2/7] Loading kernel modules..."
modprobe -q btrfs 2>/dev/null || echo "  [WARN] btrfs module not available (built-in?)"
modprobe -q servecosys_probe 2>/dev/null || echo "  [WARN] servecosys_probe module not available"
modprobe -q servecosys_guard 2>/dev/null || echo "  [WARN] servecosys_guard module not available"

# ============================================
# [3/7] Hardware fingerprint
# ============================================
echo "[3/7] Hardware fingerprint..."
if [ -f "$FINGERPRINT_SYSFS" ]; then
    FINGERPRINT=$(cat "$FINGERPRINT_SYSFS")
    echo "  Fingerprint: $FINGERPRINT"

    if [ -f /boot/servecosys/fingerprint.bin ]; then
        STORED_FP=$(cat /boot/servecosys/fingerprint.bin | hexdump -C 2>/dev/null | head -1 || echo "")
        if [ -n "$STORED_FP" ] && [ "$FINGERPRINT" != "$STORED_FP" ]; then
            echo "  [WARN] Hardware fingerprint changed!"
            echo "  [WARN] New hardware detected or hardware modified."
            echo "  [WARN] Continuing with new fingerprint..."
        fi
    fi
else
    echo "  Fingerprint sysfs not available (normal for first boot or missing module)"
fi

# ============================================
# [4/7] Root device discovery
# ============================================
echo "[4/7] Searching for root device..."
ROOT_DEV=""

scan_block_device() {
    local dev="$1"
    if [ -b "$dev" ] && blkid -t TYPE=btrfs "$dev" >/dev/null 2>&1; then
        ROOT_DEV="$dev"
        return 0
    fi
    return 1
}

# Try common device paths
for dev in \
    /dev/sda2 /dev/sda1 /dev/sdb2 /dev/sdb1 \
    /dev/nvme0n1p2 /dev/nvme0n1p1 /dev/nvme1n1p2 /dev/nvme1n1p1 \
    /dev/mmcblk0p2 /dev/mmcblk0p1 /dev/mmcblk1p2 /dev/mmcblk1p1 \
    /dev/vda2 /dev/vda1 /dev/xvda2 /dev/xvda1
do
    if scan_block_device "$dev"; then
        echo "  Found Btrfs root: $ROOT_DEV"
        break
    fi
done

# Try scanning all block devices if not found
if [ -z "$ROOT_DEV" ]; then
    echo "  Scanning all block devices for Btrfs..."
    for dev in /dev/sd* /dev/nvme* /dev/mmcblk* /dev/vd* /dev/xvd*; do
        [ -b "$dev" ] || continue
        if scan_block_device "$dev"; then
            echo "  Found Btrfs root: $ROOT_DEV"
            break
        fi
    done
fi

if [ -z "$ROOT_DEV" ]; then
    # 概念OS live 模式兜底：
    # ISO 介质上没有 btrfs 根，但 initramfs 自带了完整 system/ 层与
    # .smle/.ssle 产物。在 tmpfs 上重建根，直接切到 /sbin/init -> /system/sysinit，
    # 使概念OS 能从 live ISO 真启动（无需外部磁盘）。
    echo "[4/7] No btrfs root found - falling back to live OS mode"
    if [ -d /system ] && [ -x /system/sysinit ]; then
        echo "  Live system layer found in initramfs"
        echo "  Building tmpfs root at /live..."
        mkdir -p /live
        mount -t tmpfs tmpfs /live || { echo "  [ERROR] cannot mount tmpfs"; exec /bin/sh; }

        echo "  Copying system layer..."
        cp -a /system /live/system 2>/dev/null || { echo "  [ERROR] copy /system failed"; exec /bin/sh; }
        for d in proc sys dev run tmp sbin bin; do mkdir -p "/live/$d"; done

        # /sbin/init -> /system/sysinit（tmpfs 支持符号链接）
        ln -sf /system/sysinit /live/sbin/init
        chmod +x /live/system/sysinit /live/system/*.sh 2>/dev/null || true

        # 移动伪文件系统到新根
        for m in proc sys dev run; do
            mount --move "/$m" "/live/$m" 2>/dev/null || true
        done

        echo "  Executing switch_root -> /sbin/init (concept OS live)"
        exec switch_root /live /sbin/init
    fi

    echo "[ERROR] No Btrfs root device found!"
    echo "  Available block devices:"
    ls -la /dev/[s,n,m,v,x]d* 2>/dev/null || echo "  (none)"
    echo ""
    echo "Dropping to emergency shell..."
    exec /bin/sh
fi

# ============================================
# [5/7] Mount @system subvolume
# ============================================
echo "[5/7] Mounting Btrfs @system subvolume..."
mkdir -p "$ROOT_MOUNT"

# First mount the Btrfs top-level to inspect subvolumes
mount -t btrfs -o ro "$ROOT_DEV" /tmp 2>/dev/null || mkdir -p /tmp

# Check if @system subvolume exists
if btrfs subvolume list /tmp 2>/dev/null | grep -q "@system"; then
    mount -o subvol=@system,ro "$ROOT_DEV" "$ROOT_MOUNT"
    echo "  Mounted @system subvolume"
else
    # Fallback: mount the default subvolume
    mount -t btrfs -o ro "$ROOT_DEV" "$ROOT_MOUNT"
    echo "  @system not found, mounted default subvolume"
fi

umount /tmp 2>/dev/null || true

# ============================================
# [6/7] Snapshot boot configuration
# ============================================
echo "[6/7] Checking snapshot configuration..."
if [ -f "${ROOT_MOUNT}${SNAPSHOT_CONF}" ]; then
    SNAPSHOT_ID=$(grep "^SNAPSHOT=" "${ROOT_MOUNT}${SNAPSHOT_CONF}" | cut -d= -f2)
    if [ -n "$SNAPSHOT_ID" ]; then
        if [ "$SNAPSHOT_ID" = "LATEST" ]; then
            echo "  Boot config: LATEST snapshot"
            LATEST_SNAP=$(ls -dt /mnt/root/.snapshots/*/ 2>/dev/null | head -1)
            if [ -n "$LATEST_SNAP" ]; then
                SNAPSHOT_ID=$(basename "$LATEST_SNAP")
                umount "$ROOT_MOUNT"
                mount -o subvol="@snapshots/$SNAPSHOT_ID",ro "$ROOT_DEV" "$ROOT_MOUNT"
                echo "  Booted from latest snapshot: $SNAPSHOT_ID"
            fi
        elif [ -d "${ROOT_MOUNT}/.snapshots/${SNAPSHOT_ID}" ]; then
            echo "  Boot config: snapshot $SNAPSHOT_ID"
            umount "$ROOT_MOUNT"
            mount -o subvol="@snapshots/$SNAPSHOT_ID",ro "$ROOT_DEV" "$ROOT_MOUNT"
            echo "  Booted from snapshot: $SNAPSHOT_ID"
        else
            echo "  Snapshot '$SNAPSHOT_ID' not found, using @system"
        fi
    fi
else
    echo "  No snapshot config found, booting @system"
fi

# ============================================
# [7/7] Switch to real root
# ============================================
echo "[7/7] Switching to real root..."

# Prepare mount points in the new root
mkdir -p "$ROOT_MOUNT/proc" "$ROOT_MOUNT/sys" "$ROOT_MOUNT/dev" "$ROOT_MOUNT/run"

# Move pseudo filesystems to new root
mount --move /proc "$ROOT_MOUNT/proc" 2>/dev/null || true
mount --move /sys "$ROOT_MOUNT/sys" 2>/dev/null || true
mount --move /dev "$ROOT_MOUNT/dev" 2>/dev/null || true
mount --move /run "$ROOT_MOUNT/run" 2>/dev/null || true

echo "  Executing switch_root to $ROOT_MOUNT..."
echo "  (/sbin/init -> system/sysinit: SED up, arbitration authority, then UID)"
echo "============================================="

exec switch_root "$ROOT_MOUNT" /sbin/init

# Fallback: if switch_root fails
echo "[ERROR] Failed to switch root! Dropping to emergency shell."
exec /bin/sh
